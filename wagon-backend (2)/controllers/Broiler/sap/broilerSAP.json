{
    "plant": {
        "sapEndpoint": "mobile_app/shed_ready/get_plant",
        "pgTable": "plant",
        "primaryKey": ["plant_id"],
        "sapPrimaryKey": "key",
        "fields": [
            {"sap": "key", "db": "plant_id"},
            {"sap": "text", "db": "plant_name"}
        ]
    },
    "farmer": {
        "sapEndpoint": "zfarm_det",
