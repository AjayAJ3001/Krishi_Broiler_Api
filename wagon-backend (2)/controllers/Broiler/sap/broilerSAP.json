            {"sap": "werks", "db": "plant"},
            {"sap": "zfarmno", "db": "farmer_no"},
            {"sap": "name1", "db": "farmer_name"},
            {"sap": "lifnr", "db": "farmer_supplier"},
            {"sap": "zzline", "db": "line_no"},
            {"sap": "zzlinen", "db": "line_name"},
            {"sap": "zzfownname", "db": "owner_name"},
            {"sap": "zzfownmobno", "db": "owner_mobile_no"},
            {"sap": "zzfarmtyp", "db": "farm_type"},
            {"sap": "zzflength", "db": "farm_length"},
            {"sap": "zzfwidth", "db": "farm_width"},
            {"sap": "zzfcap", "db": "farm_capacity"},
            {"sap": "zzchc", "db": "farm_chick_house_capacity"},
            {"sap": "status", "db": "farm_status"}
        ]
    },
    "employee": {
        "sapEndpoint": "emp_master",
        "pgTable": "employee",
        "primaryKey": ["emp_id"],
        "sapPrimaryKey": "pernr",
        "fields": [
            {"sap": "pernr", "db": "emp_id"},
            {"sap": "sname", "db": "emp_name"}
        ]
    },
    "material": {
        "sapEndpoint": "masters/material",
        "pgTable": "material",
        "primaryKey": ["plant", "material_id"],
        "sapPrimaryKey": "matnr",
        "fields": [
            {"sap": "werks", "db": "plant"},
            {"sap": "matnr", "db": "material_id"},
            {"sap": "maktx", "db": "material_name"},
            {"sap": "lgort", "db": "storage_location"},
            {"sap": "meins", "db": "uom"}
        ]
    },
    "chick_delivery": {
        "sapEndpoint": "chick_grn",
        "pgTable": "chick_delivery",
        "primaryKey": ["client", "plant", "dc_no", "farmer", "batch"],
        "sapPrimaryKey": "dcno",
        "fields": [
            {"sap": "mandt", "db": "client"},
            {"sap": "werks", "db": "plant"},
