            {"sap": "bldat", "db": "document_date"},
            {"sap": "budat", "db": "posting_date"}
        ]
    },
    "customer": {
        "sapEndpoint": "customer",
        "pgTable": "customer",
        "primaryKey": ["customer_no"],
        "sapPrimaryKey": "kunnr",
        "fields": [
            {"sap": "kunnr", "db": "customer_no"},
            {"sap": "name1", "db": "customer_name"}
        ]
