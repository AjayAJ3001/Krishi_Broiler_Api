<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Delivery Challan</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #fff;
        }

        .container {
            width: 900px;
            margin: auto;
            border: 2px solid #000;
            padding: 10px;
        }


        .header {
            display: flex;
            align-items: center;
            border-bottom: 2px solid #000;
            padding: 15px;
        }

        .company-logo {
            width: 160px;
            height: auto;
        }

        .company-details {
            margin-left: 40px;
            font-size: 14px;
            line-height: 1.8;
        }

        .title {
            text-align: center;
            font-weight: bold;
            padding: 6px;
            margin-top: 5px;
            background-color: #f2e500
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
            font-size: 14px;
        }

        td,
        th {
            padding: 6px;
        }

        .section {
            border: 2px solid #000;
        }

        .section td,
        .section th {
            border: none;
        }

        .spaced td {
            padding: 12px;
            line-height: 2;
        }

        .border-right {
            border-right: 2px solid #000;
        }

        .border-top {
            border-top: 2px solid #000;
        }

        .border-bottom {
            border-bottom: 2px solid #000;
        }

        .left {
            text-align: left;
        }

        .center {
            text-align: center;
        }

        .amount {
            text-align: right;
            font-weight: bold;
            padding-right: 10px;
            line-height: 2;
        }

        .footer {
            text-align: center;
            border-top: 2px solid #000;
            margin-top: 10px;
            padding-top: 5px;
            font-size: 12px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <img class="company-logo" src="https://i.postimg.cc/L5VKhNt5/Logo-2.png" alt="Krishi Logo" />
            <div class="company-details">
                <b>KRISHI NUTRITION COMPANY PRIVATE LIMITED</b><br>
                Bill From : D.NO.41TPA, MUTHU ACHARI STREET, NEAR GEETHANJALI PRIMARY SCHOOL,<br>
                KAVERIPATTINAM, KRISHNAGIRI (DT), TAMIL NADU - 635112<br>
                GST/IN No.: 33AAFCK1198R1ZO <br>
                <p>DOC. No. : <%= doc_no %> </p>
            </div>
        </div>

        <div class="title">
            Delivery Challan (only for stock movement within the state)
        </div>

        <!-- DC / Date / Remarks -->
        <table class="section">
            <tr class="border-bottom">
                <td class="border-right left"><b>DC No:</b> <%= dc_no %> </td>
                <td class="border-right center"><b>Date:</b> <%= date %> </td>
                <td class="left"><b>Remarks</b></td>
            </tr>
            <tr>
                <td class="border-right left">
                    <b>Shipped From (Farm):</b><br>
                    THANGAVEL - THANGAMEDU<br>
                    KANJIKOVIL, PERUNDURAI - 638052,<br>
                    ERODE DISTRICT, TAMILNADU
                </td>
                <td colspan="2" class="left">
                    <b>Bill / Delivery To:</b><br>
                    VIYAAN ENTERPRISE<br>
                    PATTAKARANPALAYAM, PERUNDURAI<br>
                    ERODE - 638052, TAMILNADU
                </td>
            </tr>
        </table>

        <!-- Birds Table -->
        <table class="section">
            <thead>
                <tr class="border-bottom">
                    <th>S.No</th>
                    <th>CAGE (No)</th>
                    <th>No. of Birds</th>
                    <th>EMPTY WT (kgs)</th>
                    <th>LOAD WT (kgs)</th>
                </tr>
            </thead>
            <tbody>
                <% 
                   var totalCage = 0;
                   var totalBirds = 0;
                   var totalEmpty = 0;
                   var totalLoad = 0;
                   for(var i=0; i<load_details.length; i++){
                       totalCage += Number(load_details[i].cage || 0);
                       totalBirds += Number(load_details[i].birdQty || 0);
                       totalEmpty += parseFloat(load_details[i].emptyWeight);
                       totalLoad += parseFloat(load_details[i].loadWeight);
                %>
                <tr>
                    <td><%= i+1 %></td>
                    <td><%= load_details[i].cage %></td>
                    <td><%= load_details[i].birdQty %></td>
                    <td><%= load_details[i].emptyWeight %></td>
                    <td><%= load_details[i].loadWeight %></td>
                </tr>
                <% } %>

                <tr class="border-top">
                    <td colspan="1">Total</td>
                    <td><%= totalCage %></td>
                    <td><%= totalBirds %></td>
                    <td><%= totalEmpty.toFixed(2) %></td>
                    <td><%= totalLoad.toFixed(2) %></td>
                </tr>
            </tbody>
        </table>


        <!-- Approx Value -->
        <table class="section spaced">
            <tr>
                <td class="left">
                    <b>Approx. Rate (Per Kg in Rs.)</b><br>
                    <b>Approx. Value</b><br>
                    (Amount in Rs. xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)<br>
                    The approximate value is declared only provisionally and not final value
                </td>
                <td class="amount">
                    <%= rate.toFixed(2) %><br><br>
                    <%= gross_value.toFixed(2) %>
                </td>
            </tr>
        </table>

        <!-- Vehicle Info -->
        <table class="section spaced">
            <tr>
                <td class="left">
                    <b>Vehicle No:</b> <%= vehicle_no %><br>
                    <b>Driver Name:</b> <%= driver_name %><br>
                    <b>Supervisor:</b> <%= supervisor_name %><br>
                    <b>Weighing Scale No:</b> <%= weight_scale_no %><br>
                    <b>Start Time:</b> <%= start_time %>
                </td>
                <td class="left">
                    <b>Mobile No:</b> <%= driver_mobile %><br><br>
                    <b>End Time:</b> <%= end_time %>
                </td>
            </tr>
        </table>
        <div class="footer">
            This is a computer generated document and hence does not require signature
        </div>

    </div>

</body>

</html>